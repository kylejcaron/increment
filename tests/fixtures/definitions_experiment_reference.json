       "sql": null
      },
      {
       "description": "Query-based exposure for experiments that use a dedicated enrollment table. Returns raw enrollment rows rather than aggregating per unit: first_exposures() takes the first row per unit itself, keeping the timestamp paired with the arm it was recorded with. Collapsing with MIN(event_at) plus ANY_VALUE(variant) would pair the earliest timestamp with an arbitrary arm and hide a unit enrolled in two arms from the mixed-assignment check.\n",
       "fact": null,
       "filters": [],
       "name": "sql_enrolled",
       "sql": "SELECT\n  user_id AS unit_id,\n  event_at AS ts,\n  variant AS group_id\nFROM analytics.enrollments\nWHERE experiment_id = 'experiment_name'\n"
